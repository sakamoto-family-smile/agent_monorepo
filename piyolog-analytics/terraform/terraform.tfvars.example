################################################################################
# terraform.tfvars 例。`cp terraform.tfvars.example terraform.tfvars` で複製し、
# 実際の値で埋めること。`terraform.tfvars` は git に commit しない (.gitignore 済)。
#
# 注意: `project_id` はこのファイルでは指定しない。env で渡す。
#       `export TF_VAR_project_id=$PROJECT_ID` (Terraform が自動で var に流す)
#       これにより同じ tfvars で複数 project (dev / prod) を切替可能。
################################################################################

# 推奨デフォルト (必要に応じて上書き)
# region は実デプロイ・共有インスタンス (shared-pg) と揃えて asia-northeast1。
region      = "asia-northeast1"
name_prefix = "piyolog"

# Cloud SQL 構成 (家族用は db-f1-micro / ZONAL で月 ~$10)
# cloud_sql_tier             = "db-f1-micro"
# cloud_sql_database_version = "POSTGRES_15"
# cloud_sql_disk_size        = 10
# cloud_sql_availability     = "ZONAL"
# cloud_sql_backup_enabled   = true
# cloud_sql_db_name          = "piyolog"
# cloud_sql_db_user          = "piyolog"

# 開発環境では false にしないと `terraform destroy` で消せない (本番は true 推奨)
cloud_sql_deletion_protection = true

# ---- PROPOSAL-0009 P1: Cloud SQL 集約 ----
# 専用 piyolog インスタンスをやめて共有インスタンス (shared-pg) に相乗りする場合に true。
# 切替はデータ移行 (dump → restore) を伴う。terraform/README.md の移行手順参照。
# true のときは shared_cloudsql_instance_name が必須 (variables.tf の validation で検証)。
# cloud_sql_use_shared_instance = true
# shared_cloudsql_instance_name = "shared-pg"

# Artifact Registry
# ar_repo_name = "piyolog-analytics"

# LINE secrets の初期 version を TF で投入する場合は true にして value を埋める。
# ただし state にシークレットが書き込まれるため、本番では false 推奨で
# `gcloud secrets versions add` で手動投入する。
create_line_secret_versions = false
# line_channel_secret_value       = ""
# line_channel_access_token_value = ""

# ---- Phase 4-A: Backup bucket ----
# `make tf-destroy` 前に `make backup` で Cloud SQL を GCS にバックアップ →
# 再 apply 後に `make restore` で復元することで、課金停止サイクルでデータが消えない。
backup_retention_days       = 90
backup_bucket_force_destroy = false  # 完全削除時に bucket も消したい場合は true
