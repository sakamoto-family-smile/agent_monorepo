# ローカル本番 (Mac mini 常駐) の backend に渡す環境変数 (PROPOSAL-0013)。
#   cp config/local.env.example config/local.env && chmod 600 config/local.env
# git には入れない。GCP (Cloud Run) の env は terraform/ が持つので、ここは GCP との差分を中心に書く。
# パスはコンテナ内のもの (/app/var = ホストの ${STOCK_LOCAL_DATA_DIR:-./data/local})。

# ── 実行環境 ───────────────────────────────────────────────────
# local にしない: prod にすると認証のない旧 Web API と /docs が無効になる (Webhook は公開されるため)
APP_ENV=prod
LOG_LEVEL=info
CLAUDE_AGENT_SDK_SKIP_VERSION_CHECK=1

# ── 秘密情報 (GCP では Secret Manager) ─────────────────────────
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=
BRAVE_API_KEY=
EDINET_API_KEY=

# ── アクセス制御 / コスト上限 (GCP の terraform.tfvars と同じ値にする) ──
FAMILY_USER_IDS=
ANALYZE_RATE_LIMIT_PER_DAY=20

# ── 公開 URL (Tailscale Funnel) ────────────────────────────────
# https://<TS_HOSTNAME>.<tailnet 名>.ts.net。チャート画像 / 全文リンクの生成に使う
PUBLIC_BASE_URL=

# ── DB: SQLite (GCP では shared Cloud SQL) ─────────────────────
DB_PATH=/app/var/stock_analysis.db
# スキーマは GCP と同じく alembic で管理する (db_copy で Postgres と往復させるため)
DB_AUTO_CREATE=false
RUN_MIGRATIONS=true

# ── 非同期処理: in-process (GCP では Cloud Tasks + worker) ─────
TASKS_ENABLED=false

# ── media: インメモリ配信 (GCP では GCS 署名付き URL) ──────────
# GCS 版の署名付き URL と同じ 24 時間にそろえる。backend を再起動すると消える
MEDIA_BACKEND=memory
IMAGE_STORE_TTL_SECONDS=86400
REPORT_STORE_TTL_SECONDS=86400
IMAGE_STORE_MAX_ENTRIES=200
REPORT_STORE_MAX_ENTRIES=200

# ── データディレクトリ ────────────────────────────────────────
DATA_DIR=/app/var
CHARTS_DIR=/app/var/charts
REPORTS_DIR=/app/var/reports
CACHE_DIR=/app/var/cache
DICTIONARIES_DIR=/app/var/dictionaries

# ── EDINET (GCP では GCS) ─────────────────────────────────────
EDINET_ENABLED=true
# Edinetcode.csv は手動で ${STOCK_LOCAL_DATA_DIR}/edinet-code/ に置く (GCS の edinet-code/ と同じもの)
EDINET_CODE_CSV_PATH=/app/var/edinet-code/Edinetcode.csv
EDINET_CACHE_BACKEND=local
EDINET_CACHE_ROOT=/app/var/edinet
# EDINET_ENABLE_XBRL=true   # false で PDF のみ (メモリが減る)

# ── 価格予測 ─────────────────────────────────────────────────
# FORECAST_ENABLED=true

# ── 同時分析数 (GCP では Cloud Tasks の queue が上限を持つ) ─────
# 分析 1 件で最大 1〜1.5GB。backend の mem_limit (4g) に収まるよう 2 件まで
ANALYSIS_MAX_CONCURRENCY=2

# ── backend 内の定期処理 (GCP では Cloud Run Job + Scheduler。既定は無効) ──
# 止めたいものは false にする。時刻は Asia/Tokyo
EDINET_SCHEDULE_ENABLED=true
EDINET_SCHEDULE_TIME=02:00
BACKUP_ENABLED=true
BACKUP_TIME=03:00
BACKUP_DIR=/app/var/backups
BACKUP_RETENTION_DAYS=14
SCHEDULER_STATE_PATH=/app/var/scheduler_state.json

# ── 死活監視 ─────────────────────────────────────────────────
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=300
# 異常 / 復旧を LINE で知らせる管理者の userId (CSV)。家族には送らない
HEALTH_NOTIFY_USER_IDS=
# Healthchecks.io の ping 先。security-platform (config/vuln.env) と同じ Ping key を使う。
# slug は stock-backend / stock-health / stock-edinet_index / stock-backup (自動作成)
HEALTHCHECK_PING_BASE=

# ── 利用ログ: ローカル JSONL (GCP では Pub/Sub → GCS → BigQuery) ──
ANALYTICS_ENABLED=true
ANALYTICS_STORAGE_BACKEND=local
ANALYTICS_DATA_DIR=/app/var/analytics
ANALYTICS_SERVICE_NAME=stock-analysis-agent
# Phoenix などを立てないなら空のまま (span を export しない)
OTEL_EXPORTER_OTLP_ENDPOINT=
