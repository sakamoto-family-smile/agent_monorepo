# backend にだけ渡す。cp config/local.env.example config/local.env (git には入れない)
APP_ENV=prod

# golf-notes 専用の LINE 公式アカウント (チャンネル) の値。既存の Bot とは共有しない
# LINE Developers → チャネル基本設定 / Messaging API設定
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 保存を許可する LINE userId (自分だけ。カンマ区切り)。空なら何も保存しない
# LINE Developers → チャネル基本設定 → あなたのユーザーID
ALLOWED_USER_IDS=

# push の月の上限 (LINE の無料の通数は月 200 通。失敗の通知と週次レポートは上限を超えても送る)
# PUSH_MONTHLY_LIMIT=150

# 日次バックアップ (data/backup/golf-YYYYMMDD.db)。この時刻以降にその日の分を作り、この世代数を残す
# BACKUP_HOUR=3
# BACKUP_KEEP=14

# Healthchecks.io の ping URL (5 分おき。バックアップ失敗時は /fail)。空なら ping しない
HEALTHCHECK_PING_URL=
