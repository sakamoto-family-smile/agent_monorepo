# fujisawa-info-bot 環境変数テンプレ。
# 本ファイルを `.env` に copy して値を埋める。 `.env` は .gitignore 済。
#
# Phase 2 までで利用する変数を全て列挙。 default は mock / inmemory のため、
# 全て空文字列でも graph は動作する (テストと同等の挙動)。

# ── LINE Messaging API ───────────────────────────────────────────────
# LINE Developer Console > Messaging API Channel > 「Channel secret」「Channel access token」 から取得。
# どちらか空文字列の間は /webhook が 503 を返す。
FUJISAWA_INFO_BOT_LINE_CHANNEL_SECRET=
FUJISAWA_INFO_BOT_LINE_CHANNEL_ACCESS_TOKEN=

# ── LLM (Phase 2) ────────────────────────────────────────────────────
# mock | vertex_anthropic
FUJISAWA_INFO_BOT_LLM_PROVIDER=mock
# vertex_anthropic 用 (mock のときは空でよい)
FUJISAWA_INFO_BOT_GCP_PROJECT_ID=
FUJISAWA_INFO_BOT_VERTEX_REGION=us-east5
FUJISAWA_INFO_BOT_ANTHROPIC_MODEL=claude-haiku-4-5@20251001
FUJISAWA_INFO_BOT_LLM_MAX_TOKENS=1024

# ── Knowledge Base (Phase 2) ─────────────────────────────────────────
# inmemory | pgvector
FUJISAWA_INFO_BOT_KB_STORE_MODE=inmemory
# mock | vertex
FUJISAWA_INFO_BOT_EMBEDDING_PROVIDER=mock
FUJISAWA_INFO_BOT_EMBEDDING_DIM=768

# pgvector のとき必須 (Cloud SQL Auth Proxy 経由なら host=127.0.0.1)
FUJISAWA_INFO_BOT_CLOUD_SQL_HOST=
FUJISAWA_INFO_BOT_CLOUD_SQL_PORT=5432
FUJISAWA_INFO_BOT_CLOUD_SQL_USER=
FUJISAWA_INFO_BOT_CLOUD_SQL_PASSWORD=
FUJISAWA_INFO_BOT_CLOUD_SQL_DATABASE=fujisawa_kb_db

# ── Feature flags ────────────────────────────────────────────────────
FUJISAWA_INFO_BOT_RAG_ENABLED=true
FUJISAWA_INFO_BOT_RAG_TOP_K=5
