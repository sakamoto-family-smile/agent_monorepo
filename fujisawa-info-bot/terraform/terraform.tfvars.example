# fujisawa-info-bot terraform.tfvars テンプレ。
# 本ファイルを `terraform.tfvars` に copy して値を埋める。 `terraform.tfvars` は
# .gitignore 済 (secret を含む可能性があるため)。

project_id = "sakamomo-family-agent"
region     = "asia-northeast1"

# fujisawa-platform が同 instance を利用中
shared_cloudsql_instance_name            = "driving-license-bot-pg"
shared_cloudsql_instance_connection_name = "sakamomo-family-agent:asia-northeast1:driving-license-bot-pg"

# 初回 apply は image="" でリソース基盤 (SA / IAM / secrets / Artifact Registry)
# だけ作る。 Cloud Build で image push 後、 2 回目 apply で Cloud Run Service を
# 作る。
image = ""

# 本番運用時の image 例:
# image = "asia-northeast1-docker.pkg.dev/sakamomo-family-agent/fujisawa-info-bot/fujisawa-info-bot:<short_sha>"

# Cloud Run Service スペック
min_instances                   = 0
max_instances                   = 10
service_cpu                     = "1"
service_memory                  = "1Gi"
service_request_timeout_seconds = 60

# LLM (Phase 2 / 7: Vertex Anthropic Claude default)
llm_provider    = "vertex_anthropic"
vertex_region   = "us-east5"
anthropic_model = "claude-haiku-4-5@20251001"
rag_top_k       = 5
