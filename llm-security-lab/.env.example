# llm-security-lab 環境変数雛形 (proposal 0008 §4.8)。
# 使用法: `cp .env.example .env` してから値を編集する。 `.env` は git 対象外。

# ─── 必須: JupyterLab token ──────────────────────────────────────────────
# デフォルトの `localdev` は弱い token なので必ず置き換えること (proposal §3.9)。
# ランダム値生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
JUPYTER_TOKEN=CHANGE_ME_TO_32CHAR_RANDOM_VALUE

# ─── LLM ランタイム選択 ────────────────────────────────────────────────
# `ollama` (既定、 ローカル完結、 ¥0) | `vertex` (optional、 Claude API 経由、 課金あり)
LLM_RUNTIME=ollama

# Ollama でのデフォルトモデル (Phase 0b で `shared/llm_runtime/ollama_client.py` が参照)
OLLAMA_MODEL=mistral

# ─── (optional) Vertex AI Claude (LLM_RUNTIME=vertex のとき必須) ─────────
# 本 monorepo の `llm-client[vertex-gemini]` 規約に準拠
# GOOGLE_CLOUD_PROJECT=sakamomo-family-agent
# VERTEX_AI_LOCATION=us-east5

# ─── 攻撃 target ガードレール (proposal §3.9 / CONVENTIONS.md) ───────────
# 本ラボの攻撃 runner は localhost / Docker service 名のみ allowlist。
# 外部 endpoint を試行する場合のみ true に設定 (自己責任、 起動時警告)。
# LAB_ALLOW_EXTERNAL_TARGET=false

# ─── 防御 version 切替 (各章 vulnerable_app が参照、 Phase 1+) ──────────
# DEFENSE_VERSION=v0
