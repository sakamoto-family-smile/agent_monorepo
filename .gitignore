# Claude Code ローカル状態 (セッション・権限許可・ロック)
# 既定では .claude/ 配下を全て ignore し、ECC project config のみ
# whitelist で commit する。`.claude/*` (ディレクトリそのものは ignore しない)
# 形式にすることで git が再帰し、`!` ルールが効くようにしている。
.claude/*

# ECC (Everything Claude Code) project config は commit する
# https://github.com/affaan-m/ECC — MIT licensed (Copyright (c) 2026 Affaan Mustafa)
# scripts/setup-ecc.sh で再現可能、詳細は .claude/NOTICE.md 参照
!.claude/AGENTS.md
!.claude/PLUGIN_SCHEMA_NOTES.md
!.claude/README.md
!.claude/LICENSE
!.claude/NOTICE.md
!.claude/agents/
!.claude/commands/
!.claude/ecc/
!.claude/hooks/
!.claude/marketplace.json
!.claude/mcp-configs/
!.claude/plugin.json
!.claude/rules/
!.claude/scripts/
!.claude/skills/
!.claude/the-security-guide.md
# install-state.json は絶対パスを含むため commit せず、再 install で再生成
.claude/ecc/install-state.json

# OS
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/

# --- Secrets / runtime artifacts hardening (2026-06-05) ---
# 実値を含む env ファイル。*.example / *.secrets.example は追跡継続 (上記に未マッチ)。
.env
.env.local
.env.deploy

# Terraform plan 出力 (バイナリ。生成 password 等 planned 値を含み得る)
*.tfplan
**/terraform/*.out

# ローカル SQLite / 実行時 DB (追跡対象は無し)
*.db
*.sqlite
*.sqlite3

# stock-analysis-agent の実行時データ (analytics/uploaded 等)。
# driving-license-bot/app/data/seed_questions.json は別パスで追跡継続。
stock-analysis-agent/app/data/

# Claude Code のユーザーローカル設定 (ネストした module 配下も含む)
**/.claude/settings.local.json
