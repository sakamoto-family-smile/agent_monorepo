# notify コンテナにだけ渡す通知の送り先。cp config/notify.env.example config/notify.env
# (git には入れない。他のサービスには渡さない)

# LINE Messaging API (セキュリティ通知専用の Bot)
#   LINE Developers Console → Messaging API チャネル → 長期のチャネルアクセストークン
#   宛先は Bot を友だち追加した人の userId (CSV)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_IDS=

# GitHub Issues。必ず private リポジトリにする (未対応の脆弱性の一覧になるため)
#   fine-grained personal access token: 対象リポジトリだけ、Issues: Read and write
GITHUB_ISSUES_REPO=
GITHUB_ISSUES_TOKEN=

# NOTIFY_ISSUE_MIN_PRIORITY=P3   # この優先度までを Issue にする (P1〜P4)
# NOTIFY_DIGEST_HOUR=9           # 日次まとめを送る時刻
# NOTIFY_TIMEZONE=Asia/Tokyo
