# L4: 記事の抽出に使う LLM の設定。config/llm.env にコピーして使う (git・Docker イメージには入らない)
# このファイルは extractor コンテナにだけ渡す

# 使う LLM: claude-code (Max プラン) / fake (テスト用)。anthropic / gemini は L4 PR4
LLM_PROVIDER=claude-code
LLM_MODEL=haiku

# `claude setup-token` で発行した長期トークン (sk-ant-oat... で始まる) を = の後に書く
CLAUDE_CODE_OAUTH_TOKEN=

# 1 日に LLM を呼ぶ回数の上限と、常駐で動く時間帯 (Max プランの上限は対話と共有なので夜に回す)
# LLM_DAILY_LIMIT=50
# LLM_RUN_HOUR=3
# LLM_WINDOW_HOURS=3
# LLM_TIMEZONE=Asia/Tokyo
