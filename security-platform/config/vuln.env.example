# docker compose (intel / analytics) に渡す環境変数。cp config/vuln.env.example config/vuln.env
# config/.env (LLM / LINE / SMTP の秘密情報) はコンテナに渡さない。

# 対象エコシステム (CSV)。空なら OSV の全エコシステム (約 3GB)
# OSV_ECOSYSTEMS=PyPI,npm,Go

# 死活監視 (Healthchecks.io 互換)。ジョブごとに sec-<job> の slug へ ping する
# HEALTHCHECK_PING_BASE=https://hc-ping.com/<ping-key>

# 生データの保持日数 (KEV / EPSS / OSV 差分)。全量は OSV_RAW_FULL_SNAPSHOTS_KEPT 世代
# RAW_RETENTION_DAYS=30
# data/ の空きがこれを下回ったら大きな取得を止める (GB、0 で無効)
# MIN_FREE_DISK_GB=10
