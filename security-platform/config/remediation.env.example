# remediation コンテナにだけ渡す GitHub のトークン。cp config/remediation.env.example config/remediation.env
# (git には入れない。他のサービスには渡さない。chmod 600 にする)
#
# fine-grained personal access token: 対象リポジトリだけ
#   Contents: Read and write / Pull requests: Read and write / Actions: Read / Commit statuses: Read
#   (Workflows は付けない: 自動改修が .github/ を書き換えられないように)
# 写しを取るだけならトークンなしでも動く (public リポジトリ。未認証は 1 時間 60 回まで)。PR を作るには要る
REMEDIATION_GITHUB_TOKEN=

# true にすると依存の更新 PR を作り、自動マージを予約する。false (既定) のあいだは差分検査まで (dry_run)
# REMEDIATION_OPEN_PRS=false
# REMEDIATION_MIN_PRIORITY=P3    # この優先度までの Finding を直す (P1 は自動マージせず人がマージする)

# REMEDIATION_REPO=sakamoto-family-smile/agent_monorepo
# REMEDIATION_BRANCH=main
# REMEDIATION_MIRROR_INTERVAL_MINUTES=10
