# couple-roster-bot 環境変数サンプル。
# 実際の値を入れた .env は Git にコミットしないこと（.gitignore 済み）。
# すべて `COUPLE_ROSTER_` プレフィックス。

# ── LINE Messaging API ─────────────────────────────────────────────
COUPLE_ROSTER_LINE_CHANNEL_SECRET=
COUPLE_ROSTER_LINE_CHANNEL_ACCESS_TOKEN=

# ── 認可（夫婦 2 名の LINE user id をカンマ区切りで）──────────────
# 本番では allow_all を false にし、下に 2 人の userId を設定する。
COUPLE_ROSTER_ALLOW_ALL_USERS=true
COUPLE_ROSTER_ALLOWED_LINE_USER_IDS=

# ── ストレージ（memory | sheets）────────────────────────────────────
COUPLE_ROSTER_STORAGE_MODE=memory
COUPLE_ROSTER_SPREADSHEET_ID=
COUPLE_ROSTER_WORKSHEET_NAME=roster
# サービスアカウント鍵のパス。空なら ADC（Cloud Run のサービスアカウント）。
COUPLE_ROSTER_GOOGLE_CREDENTIALS_PATH=

# ── OCR（mock | drive | vision）─────────────────────────────────────
COUPLE_ROSTER_OCR_PROVIDER=mock

# ── LIFF ───────────────────────────────────────────────────────────
COUPLE_ROSTER_LIFF_ID=
# Cloud Run の公開 URL（LIFF フォーム / 返信リンクの生成に使う）。
COUPLE_ROSTER_PUBLIC_BASE_URL=
